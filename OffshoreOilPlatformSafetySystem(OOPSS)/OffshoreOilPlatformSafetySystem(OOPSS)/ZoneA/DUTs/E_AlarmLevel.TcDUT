  <DUT Name="E_AlarmLevel" Id="{ceb44317-d50e-4030-bf72-bd09b40791ed}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_AlarmLevel :
(
	    NONE        := 0,
    INFO        := 1,   // log only
    WARNING     := 2,   // operator attention
    CRITICAL    := 3    // immediate action
);
END_TYPE
]]></Declaration>
  </DUT>
