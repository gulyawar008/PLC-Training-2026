<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_AlarmManager" Id="{8aab6558-0169-44c0-b09f-87045a077175}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AlarmManager IMPLEMENTS I_AlarmManager
VAR
    _aLog           : ARRAY[1..50] OF ST_AlarmRecord;
    _nLogHead       : INT := 0;
    _nLogCount      : INT := 0;
    _nActiveAlarms  : INT := 0;
    _eHighestLevel  : E_AlarmLevel := E_AlarmLevel.NONE;
    _nNextRecordId  : UDINT := 1;
    _pProfile       : I_AlarmProfile;
    _fbNormal       : FB_NormalAlarmProfile;
END_VAR
VAR_OUTPUT
    nActiveAlarmCount   : INT;
    eHighestAlarmLevel  : E_AlarmLevel;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ensure profile never null
IF _pProfile = 0 THEN
    _pProfile := _fbNormal;
END_IF

// update output VARs every cycle
nActiveAlarmCount  := _nActiveAlarms;
eHighestAlarmLevel := _eHighestLevel;]]></ST>
    </Implementation>
    <Method Name="AcknowledgeAlarm" Id="{96d8611e-b757-41a6-968d-2e210736fd12}">
      <Declaration><![CDATA[METHOD AcknowledgeAlarm : BOOL
VAR_INPUT
    nRecordId  : UDINT;
    sOperator  : STRING;
END_VAR
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i := 1 TO GVL_SafetyLimits.c_nALARM_LOG_SIZE DO
    IF _aLog[i].nRecordId = nRecordId
       AND NOT _aLog[i].bAcknowledged THEN
        _aLog[i].bAcknowledged   := TRUE;
        _aLog[i].sAcknowledgedBy := sOperator;
        IF _nActiveAlarms > 0 THEN
            _nActiveAlarms := _nActiveAlarms - 1;
        END_IF
        AcknowledgeAlarm := TRUE;
        RETURN;
    END_IF
END_FOR

AcknowledgeAlarm := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearAlarm" Id="{cf46ea37-910c-4c1a-8437-640364018d67}">
      <Declaration><![CDATA[METHOD ClearAlarm : BOOL
VAR_INPUT
    nRecordId : UDINT;
END_VAR
VAR
    i : INT;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO GVL_SafetyLimits.c_nALARM_LOG_SIZE DO
    IF _aLog[i].nRecordId = nRecordId THEN
        _aLog[i].eLevel        := E_AlarmLevel.NONE;
        _aLog[i].bAcknowledged := TRUE;
        IF _nActiveAlarms > 0 THEN
            _nActiveAlarms := _nActiveAlarms - 1;
        END_IF
        ClearAlarm := TRUE;
        RETURN;
    END_IF
END_FOR

ClearAlarm := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearZoneAlarms" Id="{d867512a-b059-4e1f-a5de-653a6a432aba}">
      <Declaration><![CDATA[METHOD ClearZoneAlarms 
VAR_INPUT
    eZone : E_ZoneId;
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[



FOR i := 1 TO GVL_SafetyLimits.c_nALARM_LOG_SIZE DO
    IF _aLog[i].eZone = eZone
       AND _aLog[i].eLevel <> E_AlarmLevel.NONE THEN
        _aLog[i].eLevel        := E_AlarmLevel.NONE;
        _aLog[i].bAcknowledged := TRUE;
        IF _nActiveAlarms > 0 THEN
            _nActiveAlarms := _nActiveAlarms - 1;
        END_IF
    END_IF
END_FOR

// recalculate highest level after clearing
_eHighestLevel := E_AlarmLevel.NONE;
FOR i := 1 TO GVL_SafetyLimits.c_nALARM_LOG_SIZE DO
    IF _aLog[i].eLevel > _eHighestLevel THEN
        _eHighestLevel := _aLog[i].eLevel;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetActiveAlarmCount" Id="{da4e89c9-5cac-4aa6-855e-9dab4de1138b}">
      <Declaration><![CDATA[METHOD GetActiveAlarmCount : INT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
GetActiveAlarmCount := _nActiveAlarms;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHighestAlarmLevel" Id="{1b39ba0b-58e8-45e6-ad5d-cd2fd7e917ed}">
      <Declaration><![CDATA[METHOD GetHighestAlarmLevel : E_AlarmLevel
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ GetHighestAlarmLevel := _eHighestLevel;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RaiseAlarm" Id="{32f6a156-ab0c-4c4e-b47d-1cebdaf65038}">
      <Declaration><![CDATA[METHOD RaiseAlarm : BOOL
VAR_INPUT
    eLevel      : E_AlarmLevel;
    eZone       : E_ZoneId;
    nSensorId   : INT;
    rValue      : REAL;
    sDesc       : STRING;
END_VAR
VAR
    stRecord : ST_AlarmRecord;
    i        : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

// skip NONE level
IF eLevel = E_AlarmLevel.NONE THEN
    RaiseAlarm := FALSE;
    RETURN;
END_IF

// maintenance mode suppression
// suppress INFO alarms when profile requires 2+ sensors
IF _pProfile <> 0 THEN
    IF eLevel = E_AlarmLevel.INFO
       AND _pProfile.GetVoteAlert() > 1 THEN
        RaiseAlarm := FALSE;
        RETURN;
    END_IF
END_IF

// duplicate check — same zone same level already active
FOR i := 1 TO GVL_SafetyLimits.c_nALARM_LOG_SIZE DO
    IF _aLog[i].eZone  = eZone
       AND _aLog[i].eLevel = eLevel
       AND NOT _aLog[i].bAcknowledged
       AND _aLog[i].eLevel <> E_AlarmLevel.NONE THEN
        RaiseAlarm := FALSE;
        RETURN;
    END_IF
END_FOR

// build record
stRecord.nRecordId     := _nNextRecordId;
stRecord.eLevel        := eLevel;
stRecord.eZone         := eZone;
stRecord.nSensorId     := nSensorId;
stRecord.rSensorValue  := rValue;
stRecord.sDescription  := sDesc;
stRecord.bAcknowledged := FALSE;

// ring buffer write
IF _nLogHead >= GVL_SafetyLimits.c_nALARM_LOG_SIZE THEN
    _nLogHead := 1;
ELSE
    _nLogHead := _nLogHead + 1;
END_IF

_aLog[_nLogHead] := stRecord;
_nNextRecordId   := _nNextRecordId + 1;

IF _nLogCount < GVL_SafetyLimits.c_nALARM_LOG_SIZE THEN
    _nLogCount := _nLogCount + 1;
END_IF

_nActiveAlarms := _nActiveAlarms + 1;

IF eLevel > _eHighestLevel THEN
    _eHighestLevel := eLevel;
END_IF

RaiseAlarm := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetProfile" Id="{c7cc1065-6614-498b-85db-2ba97056e784}">
      <Declaration><![CDATA[METHOD SetProfile
VAR_INPUT
    pProfile : I_AlarmProfile;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Inject whichever profile Central passes in
_pProfile := pProfile;


]]></ST>
      </Implementation>
    </Method>
