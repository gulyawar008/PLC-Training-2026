      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_ESDController.ResetESD">
      <LineId Id="44" Count="31" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>