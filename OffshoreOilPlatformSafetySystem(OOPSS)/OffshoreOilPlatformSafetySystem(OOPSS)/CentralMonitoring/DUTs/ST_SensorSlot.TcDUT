  <DUT Name="ST_SensorSlot" Id="{f936c7a3-87ba-4d9c-849b-1c9dc59452c9}">
    <Declaration><![CDATA[TYPE ST_SensorSlot :
STRUCT
	    pSensor         : I_SafetySensor;
       bOccupied       : BOOL;
        bIsH2SCritical  : BOOL;     // set TRUE when registering H2S sensors
	    bIsSmokeCritical    : BOOL;     // smoke forces emergency like H2S
	    eSensorType         : E_SensorType; 
END_STRUCT
END_TYPE
]]></Declaration>
