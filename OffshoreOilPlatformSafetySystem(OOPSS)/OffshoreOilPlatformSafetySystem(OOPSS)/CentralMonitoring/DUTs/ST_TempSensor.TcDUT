<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_TempSensor" Id="{6073fdc3-9675-4dd3-99c4-64834f27dc8f}">
    <Declaration><![CDATA[TYPE ST_TempSensor :
STRUCT
	nId             : INT;
    eZone           : E_ZoneId;
    rValueCelsius   : REAL;             // reading in C
    rRateOfRise     : REAL;             // C per minute
    eStatus         : E_SensorStatus;
    bAlarm          : BOOL;
    bFault          : BOOL;
    bBypassed       : BOOL;
    tLastUpdate     : TIME;
    sLocation       : STRING;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>