  <DUT Name="E_AlarmLevel" Id="{866a4c56-2ab8-41d3-93b0-4c37e52279f7}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_AlarmLevel :
(
	    NONE        := 0,
    INFO        := 1,   // log only
    WARNING     := 2,   // operator attention
    CRITICAL    := 3    // immediate action
);
END_TYPE
]]></Declaration>
  </DUT>
