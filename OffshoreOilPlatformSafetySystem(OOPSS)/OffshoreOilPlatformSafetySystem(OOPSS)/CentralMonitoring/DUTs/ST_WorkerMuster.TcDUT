    bEvacuationComplete : BOOL;         // all safe confirmed
    bPASystemActive     : BOOL;         // PA announcement running
    eEvacuationStatus   : E_ZoneState;
    tEvacuationStarted  : DATE_AND_TIME;
    tAllClearTime       : DATE_AND_TIME;
