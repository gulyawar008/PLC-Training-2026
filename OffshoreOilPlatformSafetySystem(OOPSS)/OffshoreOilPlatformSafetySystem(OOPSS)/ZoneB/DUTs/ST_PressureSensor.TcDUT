  <DUT Name="ST_PressureSensor" Id="{c43bc0a9-3144-481c-aa81-cab2f4bcccb6}">
    <Declaration><![CDATA[TYPE ST_PressureSensor :
STRUCT
	    nId             : INT;
    eZone           : E_ZoneId;
    rValueBar       : REAL;             // reading in bar
    rRateOfChange   : REAL;             // bar per minute
    eStatus         : E_SensorStatus;
    bAlarm          : BOOL;
    bHighHighAlarm  : BOOL;             // critical level
    bFault          : BOOL;
    bBypassed       : BOOL;
    tLastUpdate     : TIME;
    sLocation       : STRING;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>