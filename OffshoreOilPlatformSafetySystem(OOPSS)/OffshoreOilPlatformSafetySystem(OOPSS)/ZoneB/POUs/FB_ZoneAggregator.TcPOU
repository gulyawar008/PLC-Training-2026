<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_ZoneAggregator" Id="{862783ec-dc18-4045-96e6-6aae4d76f566}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ZoneAggregator IMPLEMENTS I_SafetyZone
VAR
    _eZoneId        : E_ZoneId;
    _stZoneData     : ST_ZoneData;
    _aSlots         : ARRAY[1..30] OF ST_SensorSlot;
    _nSlotCount     : INT := 0;
END_VAR
VAR_INPUT
    eZoneId         : E_ZoneId;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// runs every cycle
// keeps internal zone id in sync with input
_stZoneData.eZoneId := eZoneId;]]></ST>
    </Implementation>
    <Method Name="CheckSafety" Id="{d4eaf0fb-b5d0-4537-89ea-d46334f1a3bc}">
      <Declaration><![CDATA[METHOD CheckSafety : E_ZoneState]]></Declaration>
      <Implementation>
        <ST><![CDATA[
THIS^.UpdateSensors();
CheckSafety := _stZoneData.eZoneState;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckZoneData" Id="{1f5df16d-83df-4efb-80cf-059ef7abbd1f}">
      <Declaration><![CDATA[METHOD CheckZoneData : ST_ZoneData]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CheckZoneData := _stZoneData;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetZoneState" Id="{e645b7d0-0590-4cf7-b26a-6d892f308c81}">
      <Declaration><![CDATA[METHOD GetZoneState : E_ZoneState]]></Declaration>
      <Implementation>
        <ST><![CDATA[
GetZoneState := _stZoneData.eZoneState;]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasAlarm" Id="{9b04f957-b64f-46fd-a125-cb7ff144d50f}">
      <Declaration><![CDATA[PROPERTY HasAlarm : BOOL]]></Declaration>
      <Get Name="Get" Id="{ff7000ec-935d-4edf-879c-1689f4247410}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasAlarm := _stZoneData.eWorstAlarmLevel > E_AlarmLevel.INFO;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{77ea125f-f3bd-42a0-8c86-ddde8e4b3b4a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="RegisterH2SSensor" Id="{fcaace72-5d36-40b7-a2b4-72723ca6e150}">
      <Declaration><![CDATA[METHOD RegisterH2SSensor :BOOL
VAR_IN_OUT
    fbSensor      : FB_BaseSensor;    // VAR_IN_OUT = reference
END_VAR
VAR
    ipTemp  : I_SafetySensor;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _nSlotCount >= 30 THEN
    RegisterH2SSensor := FALSE;
    RETURN;
END_IF

_nSlotCount := _nSlotCount + 1;

ipTemp := fbsensor;
_aSlots[_nSlotCount].ipSensor         := ipTemp;
_aSlots[_nSlotCount].eSensorType      := E_SensorType.H2S;
_aSlots[_nSlotCount].bOccupied        := TRUE;
_aSlots[_nSlotCount].bIsH2SCritical   := TRUE;
_aSlots[_nSlotCount].bIsSmokeCritical := FALSE;

RegisterH2SSensor := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterSensor" Id="{733ca4bb-ce29-4419-942f-f07a74098c14}">
      <Declaration><![CDATA[METHOD RegisterSensor : BOOL
VAR_IN_OUT
    fbsensor      : FB_BaseSensor;    // VAR_IN_OUT = reference
END_VAR
VAR_INPUT
    eType       : E_SensorType;
END_VAR
VAR
    ipTemp  : I_SafetySensor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF _nSlotCount >= 30 THEN
    RegisterSensor := FALSE;
    RETURN;
END_IF

_nSlotCount := _nSlotCount + 1;

// ✅ CORRECT way in TwinCAT
// assign VAR_IN_OUT reference to interface
// TwinCAT resolves vtable correctly this way
// DO NOT use ADR() for interface assignment
ipTemp := fbsensor;
_aSlots[_nSlotCount].ipSensor         := ipTemp;
_aSlots[_nSlotCount].eSensorType      := eType;
_aSlots[_nSlotCount].bOccupied        := TRUE;
_aSlots[_nSlotCount].bIsH2SCritical   := FALSE;
_aSlots[_nSlotCount].bIsSmokeCritical := FALSE;

RegisterSensor := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterSmokeSensor" Id="{23b33d24-c685-4448-aba0-4dcb4f14f75e}">
      <Declaration><![CDATA[METHOD RegisterSmokeSensor : BOOL
VAR_IN_OUT
    fbsensor      : FB_BaseSensor;    // VAR_IN_OUT = reference
END_VAR
VAR
    ipTemp  : I_SafetySensor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _nSlotCount >= 30 THEN
    RegisterSmokeSensor := FALSE;
    RETURN;
END_IF

_nSlotCount := _nSlotCount + 1;

ipTemp := fbsensor;
_aSlots[_nSlotCount].ipSensor         := ipTemp;
_aSlots[_nSlotCount].eSensorType      := E_SensorType.SMOKE;
_aSlots[_nSlotCount].bOccupied        := TRUE;
_aSlots[_nSlotCount].bIsH2SCritical   := FALSE;
_aSlots[_nSlotCount].bIsSmokeCritical := TRUE;

RegisterSmokeSensor := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{61828f95-da84-443d-8cdc-c90e183ef04d}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i := 1 TO _nSlotCount DO
    IF _aSlots[i].bOccupied THEN
        _aSlots[i].ipSensor.Reset();
    END_IF
END_FOR

_stZoneData.eZoneState       := E_ZoneState.ZONE_NORMAL;
_stZoneData.eWorstAlarmLevel := E_AlarmLevel.NONE;
_stZoneData.bESDRequired     := FALSE;
_stZoneData.bH2SAlarm        := FALSE;
Reset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TriggerESD" Id="{d3e23fcc-c120-43b7-837f-d3140042419c}">
      <Declaration><![CDATA[METHOD TriggerESD : BOOL
VAR_INPUT
    eLevel : E_ESDLevel;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_stZoneData.bESDRequired := TRUE;
_stZoneData.eZoneState   := E_ZoneState.ZONE_EMERGENCY;
TriggerESD := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateSensors" Id="{1263454a-1cfd-4981-9839-81fec9c24744}">
      <Declaration><![CDATA[METHOD UpdateSensors 
VAR
    i            : INT;
    nAlarms      : INT;
    nGasAlarms   : INT;
    nPressAlarms : INT;
    nTempAlarms  : INT;
    bH2SAlarm    : BOOL;
    bSmokeAlarm  : BOOL;
    bAnyAlarm    : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[i            := 0;
nAlarms      := 0;
nGasAlarms   := 0;
nPressAlarms := 0;
nTempAlarms  := 0;
bH2SAlarm    := FALSE;
bSmokeAlarm  := FALSE;
bAnyAlarm    := FALSE;

// ─────────────────────────────────────
// Pass 1 — H2S
// ─────────────────────────────────────
FOR i := 1 TO _nSlotCount DO
    IF _aSlots[i].bOccupied
       AND _aSlots[i].bIsH2SCritical
       AND _aSlots[i].ipSensor <> 0 THEN    // ✅ null check
        IF _aSlots[i].ipSensor.IsAlarm() THEN
            bH2SAlarm := TRUE;
        END_IF
    END_IF
END_FOR

// ─────────────────────────────────────
// Pass 2 — Smoke
// ─────────────────────────────────────
FOR i := 1 TO _nSlotCount DO
    IF _aSlots[i].bOccupied
       AND _aSlots[i].bIsSmokeCritical
       AND _aSlots[i].ipSensor <> 0 THEN    // ✅ null check
        IF _aSlots[i].ipSensor.IsAlarm() THEN
            bSmokeAlarm := TRUE;
        END_IF
    END_IF
END_FOR

// ─────────────────────────────────────
// Pass 3 — standard sensors vote count
// ─────────────────────────────────────
FOR i := 1 TO _nSlotCount DO
    IF _aSlots[i].bOccupied
       AND NOT _aSlots[i].bIsH2SCritical
       AND NOT _aSlots[i].bIsSmokeCritical
       AND _aSlots[i].ipSensor <> 0 THEN    // ✅ null check
        IF _aSlots[i].ipSensor.IsAlarm() THEN
            nAlarms   := nAlarms + 1;
            bAnyAlarm := TRUE;
            CASE _aSlots[i].eSensorType OF
                E_SensorType.GAS:
                    nGasAlarms := nGasAlarms + 1;
                E_SensorType.PRESSURE:
                    nPressAlarms := nPressAlarms + 1;
                E_SensorType.TEMP:
                    nTempAlarms := nTempAlarms + 1;
            END_CASE
        END_IF
    END_IF
END_FOR

// ─────────────────────────────────────
// Write all counts before voting
// ─────────────────────────────────────
_stZoneData.eZoneId             := eZoneId;
_stZoneData.bH2SAlarm           := bH2SAlarm;
_stZoneData.nGasAlarmCount      := nGasAlarms;
_stZoneData.nPressureAlarmCount := nPressAlarms;
_stZoneData.nTempAlarmCount     := nTempAlarms;
_stZoneData.tLastUpdate         := TIME();

IF bAnyAlarm OR bH2SAlarm OR bSmokeAlarm THEN
    _stZoneData.tLastAlarm := TIME();
END_IF

// ─────────────────────────────────────
// Voting logic
// ─────────────────────────────────────
IF bH2SAlarm OR bSmokeAlarm THEN
    _stZoneData.eWorstAlarmLevel := E_AlarmLevel.CRITICAL;
    _stZoneData.eZoneState       := E_ZoneState.ZONE_EMERGENCY;
    _stZoneData.bESDRequired     := TRUE;
    _stZoneData.sStatusMessage   := 'EMERGENCY - H2S or Smoke';

ELSIF nAlarms >= GVL_SafetyLimits.c_nVOTE_EMERGENCY THEN
    _stZoneData.eWorstAlarmLevel := E_AlarmLevel.CRITICAL;
    _stZoneData.eZoneState       := E_ZoneState.ZONE_EMERGENCY;
    _stZoneData.bESDRequired     := TRUE;
    _stZoneData.sStatusMessage   := 'EMERGENCY - ESD required';

ELSIF nAlarms >= GVL_SafetyLimits.c_nVOTE_WARNING THEN
    _stZoneData.eWorstAlarmLevel := E_AlarmLevel.WARNING;
    _stZoneData.eZoneState       := E_ZoneState.ZONE_WARNING;
    _stZoneData.bESDRequired     := FALSE;
    _stZoneData.sStatusMessage   := 'WARNING - operator action required';

ELSIF nAlarms >= GVL_SafetyLimits.c_nVOTE_ALERT THEN
    _stZoneData.eWorstAlarmLevel := E_AlarmLevel.INFO;
    _stZoneData.eZoneState       := E_ZoneState.ZONE_ALERT;
    _stZoneData.bESDRequired     := FALSE;
    _stZoneData.sStatusMessage   := 'ALERT - investigate sensor';

ELSE
    _stZoneData.eWorstAlarmLevel := E_AlarmLevel.NONE;
    _stZoneData.eZoneState       := E_ZoneState.ZONE_NORMAL;
    _stZoneData.bESDRequired     := FALSE;
    _stZoneData.sStatusMessage   := 'NORMAL - all sensors ok';
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ZoneData" Id="{54f668f2-fcb2-4835-b97a-3c629076c1d4}">
      <Declaration><![CDATA[PROPERTY  ZoneData : ST_ZoneData]]></Declaration>
