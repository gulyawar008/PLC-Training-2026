END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ZoneData := _stZoneData;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{ddc61968-16b6-4a3c-9f91-589b31c7e8c1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
