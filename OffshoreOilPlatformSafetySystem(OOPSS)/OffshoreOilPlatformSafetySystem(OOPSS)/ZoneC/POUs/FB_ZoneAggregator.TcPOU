END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ZoneData := _stZoneData;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{0c3c2426-7877-417b-a671-2d0d755105e8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
