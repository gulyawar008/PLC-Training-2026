<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_WashingMachine" Id="{2941a86e-9a2f-4d0c-a7ef-27fac7000be1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK  FB_WashingMachine
VAR
	eCurrentState      : E_WashState := E_WashState.IDLE;
    ePrevState         : E_WashState := E_WashState.IDLE;

    // Strategy
    ipStrategy         : I_WashStrategy;
    stWashSettings         : ST_WashSettings;

    // Timers
    fbOnStateTimer      : TON;

    // Internal flags
    bDoorClosed        : BOOL := FALSE;
    bWaterDetected     : BOOL := FALSE;
    bError             : BOOL := FALSE;
    sErrorMsg          : STRING := '';

    // Tracking
    nTotalCycles       : INT := 0;
    tElapsedTime       : TIME := T#0S;
    tRemainingTime     : TIME := T#0S;
    tStateStartTime    : TIME := T#0S;

    // Output
    sLog               : STRING := '';
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ─────────────────────────────────────────
// Edge case — no strategy triggers error
// ─────────────────────────────────────────
IF ipStrategy = 0 AND THIS^.IsRunning THEN
    THIS^.TriggerError(sMsg := 'Strategy lost during operation');
    RETURN;
END_IF

// ─────────────────────────────────────────
// Update remaining time every cycle
// ─────────────────────────────────────────
IF fbOnStateTimer.IN THEN
    tRemainingTime := fbOnStateTimer.PT - fbOnStateTimer.ET;
ELSE
    tRemainingTime := T#0S;
END_IF

// ─────────────────────────────────────────
// STATE MACHINE
// ─────────────────────────────────────────
CASE eCurrentState OF

    E_WashState.IDLE:
    // ─────────────────────────────────
    // Waiting for Start command
    // Transition ──► FILLING via Start()
    // ─────────────────────────────────
         fbOnStateTimer.IN := FALSE;
         bWaterDetected    := FALSE;
         sLog              := 'IDLE — select program and press start';

    E_WashState.FILLING:
    // ─────────────────────────────────
    // Filling drum with water
    // Transition ──► WASHING after fill
    // ─────────────────────────────────
        fbOnStateTimer(IN := TRUE, PT := stWashSettings.tFillDuration);

        bWaterDetected := TRUE;
        sLog := CONCAT('FILLING — Program: ', ipStrategy.GetProgramName());

        // Edge case — door opened during fill
        IF NOT bDoorClosed THEN
            THIS^.TriggerError(sMsg := 'Door opened during filling');
            RETURN;
        END_IF

        // Transition: FILLING ──► WASHING
        IF fbOnStateTimer.Q THEN
            fbOnStateTimer.IN := FALSE;
            eCurrentState    := E_WashState.WASHING;
            sLog             := 'Filling complete — starting wash';
        END_IF

    E_WashState.WASHING:
    // ─────────────────────────────────
    // Washing with strategy settings
    // Transition ──► DRAINING after wash
    // ─────────────────────────────────
        fbOnStateTimer(IN := TRUE, PT := stWashSettings.tWashDuration);

        sLog := CONCAT(
                 CONCAT('WASHING Temp: ', REAL_TO_STRING(stWashSettings.rWashTemperature)),
                 CONCAT('C Speed: ', CONCAT(INT_TO_STRING(stWashSettings.nSpinSpeed), ' RPM')));

        // Edge case — temperature exceeded
        IF stWashSettings.rWashTemperature > GVL_WashConstants.TEMP_MAX THEN
            THIS^.TriggerError(sMsg := 'Temperature exceeded maximum limit');
            RETURN;
        END_IF

        // Edge case — speed exceeded
        IF stWashSettings.nSpinSpeed > GVL_WashConstants.SPEED_MAX THEN
            THIS^.TriggerError(sMsg := 'Spin speed exceeded maximum limit');
            RETURN;
        END_IF

        // Transition: WASHING ──► DRAINING
        IF fbOnStateTimer.Q THEN
            fbOnStateTimer.IN := FALSE;
            eCurrentState    := E_WashState.DRAINING;
            sLog             := 'Washing complete — draining water';
        END_IF

    E_WashState.DRAINING:
    // ─────────────────────────────────
    // Draining water from drum
    // Transition ──► COMPLETED after drain
    // ─────────────────────────────────
        fbOnStateTimer(IN := TRUE, PT := stWashSettings.tDrainDuration);

        sLog := 'DRAINING — removing water from drum';

        // Transition: DRAINING ──► COMPLETED
        IF fbOnStateTimer.Q THEN
            fbOnStateTimer.IN := FALSE;
            bWaterDetected   := FALSE;
            eCurrentState    := E_WashState.COMPLETED;
            nTotalCycles     := nTotalCycles + 1;
            sLog             := CONCAT(
                                 CONCAT('COMPLETED — Program: ', ipStrategy.GetProgramName()),
                                 CONCAT(' Total cycles: ', INT_TO_STRING(nTotalCycles)));
        END_IF

    E_WashState.COMPLETED:
    // ─────────────────────────────────
    // Wash complete — wait for door open
    // Transition ──► IDLE on door open
    // ─────────────────────────────────
        fbOnStateTimer.IN := FALSE;
        tRemainingTime   := T#0S;
        sLog             := 'COMPLETED — Please remove clothes and open door';

        // Transition: COMPLETED ──► IDLE
        IF NOT bDoorClosed THEN
            eCurrentState := E_WashState.IDLE;
            sLog          := 'Door opened — machine ready for next cycle';
        END_IF

    E_WashState.ERROR:
    // ─────────────────────────────────
    // Error state — wait for reset
    // Transition ──► IDLE via ResetError()
    // ─────────────────────────────────
        fbOnStateTimer.IN := FALSE;
        tRemainingTime   := T#0S;
        sLog             := CONCAT('ERROR: ', sErrorMsg);

END_CASE

// Track previous state
ePrevState := eCurrentState;]]></ST>
    </Implementation>
    <Property Name="CurrentProgram" Id="{9ae5d6d9-6ad9-40e1-aefd-fa6fc10668e3}">
      <Declaration><![CDATA[PROPERTY  CurrentProgram : STRING]]></Declaration>
      <Get Name="Get" Id="{c111c71a-6cb8-4a96-9211-b44d12d7a669}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF ipStrategy = 0 THEN
    CurrentProgram := 'No program selected';
    RETURN;
END_IF
CurrentProgram := ipStrategy.GetProgramName();]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d5be7f16-4eb2-4781-8719-1777997173ec}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="CurrentState" Id="{d69cb94e-a7b2-4bd0-9661-5e10d0a1df2b}">
      <Declaration><![CDATA[PROPERTY CurrentState : E_WashState]]></Declaration>
      <Get Name="Get" Id="{3fc6311a-f53f-4bce-a7c2-3e8078fa9d41}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentState := eCurrentState;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{097f0d05-d0e7-4c3a-aad4-5670303745e2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ErrorMessage" Id="{855ecaa8-948b-46a2-81bb-097035a257c1}">
      <Declaration><![CDATA[PROPERTY ErrorMessage : STRING]]></Declaration>
      <Get Name="Get" Id="{8387c281-0323-48c5-a7c1-7900485f94af}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// GET
ErrorMessage := sErrorMsg;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{2afaca2f-d3dc-4310-b7e2-31172879f092}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="IsDoorClosed" Id="{9b700c0c-6927-4812-bfd3-0ecad098999c}">
      <Declaration><![CDATA[PROPERTY IsDoorClosed  : BOOL]]></Declaration>
      <Get Name="Get" Id="{a65907f9-501d-42fc-8a19-60fc2095e457}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsDoorClosed := bDoorClosed;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{163e4209-de28-4fe3-8676-3d202bf91482}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// Edge case — cannot open door while running
IF THIS^.IsRunning AND NOT IsDoorClosed THEN
    sLog := 'ERROR: Cannot open door while machine is running';
    RETURN;
END_IF
bDoorClosed := IsDoorClosed;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="IsRunning" Id="{05ce31fd-bba2-439b-a2ae-6ff6e930fec9}">
      <Declaration><![CDATA[PROPERTY IsRunning : BOOL]]></Declaration>
      <Get Name="Get" Id="{6ec5ce81-8d8a-4cb2-a657-4f8c749c0e28}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsRunning := (eCurrentState <> E_WashState.IDLE    AND
              eCurrentState <> E_WashState.COMPLETED AND
              eCurrentState <> E_WashState.ERROR);]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{30254e30-a4d2-4e57-9824-9ea3d28be941}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="LogMessage" Id="{e9542b3e-00d9-4d10-8acc-dad4ea2fc7b9}">
      <Declaration><![CDATA[PROPERTY LogMessage : STRING]]></Declaration>
      <Get Name="Get" Id="{0cc44213-e29f-46d7-b2b0-0d2e31cf18d4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LogMessage := sLog;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{882225c5-3cba-457f-942a-e086df3ee95f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RemainingTime" Id="{3e393044-01f3-4c2b-b907-f51eed3a5a8e}">
      <Declaration><![CDATA[PROPERTY  RemainingTime : TIME]]></Declaration>
      <Get Name="Get" Id="{57aa9742-0208-4dd7-9579-c7f79b9e0560}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RemainingTime := tRemainingTime;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{7de6a2ec-98fc-4124-952c-9819ccee5d24}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="ResetError" Id="{6eb0be3c-ae30-46d6-bc3f-446ce0a650d5}">
      <Declaration><![CDATA[METHOD ResetError : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Edge case — only reset if in error
IF eCurrentState <> E_WashState.ERROR THEN
    sLog      := 'No error to reset';
    ResetError := FALSE;
    RETURN;
END_IF

// Transition: ERROR ──► IDLE
eCurrentState    := E_WashState.IDLE;
bError           := FALSE;
sErrorMsg        := '';
bWaterDetected   := FALSE;
fbOnStateTimer.IN := FALSE;
sLog             := 'Error cleared — machine ready';
ResetError        := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectStrategy" Id="{11f9c0a5-9ac0-443b-9068-0c6940a261ee}">
      <Declaration><![CDATA[METHOD  SelectStrategy : BOOL
VAR_INPUT
	ipGetStrategy : I_WashStrategy;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Edge case — cannot change while running
IF THIS^.IsRunning THEN
    sLog          := 'ERROR: Cannot change program while running';
    SelectStrategy := FALSE;
    RETURN;
END_IF

// ✅ NONE selected — clear strategy intentionally
IF ipGetStrategy = 0 THEN
    ipStrategy     := 0;
    sLog           := 'Program cleared — please select a program';
    SelectStrategy := TRUE;    // not an error
    RETURN;
END_IF

// ✅ assign first then validate
ipStrategy     := ipGetStrategy;
stWashSettings := ipStrategy.GetWashSettings();

// validate temperature
IF stWashSettings.rWashTemperature > GVL_WashConstants.TEMP_MAX OR
   stWashSettings.rWashTemperature < GVL_WashConstants.TEMP_MIN THEN
    sLog          := 'ERROR: Temperature out of valid range';
    ipStrategy    := 0;
    SelectStrategy := FALSE;
    RETURN;
END_IF

// validate speed
IF stWashSettings.nSpinSpeed > GVL_WashConstants.SPEED_MAX OR
   stWashSettings.nSpinSpeed < GVL_WashConstants.SPEED_MIN THEN
    sLog          := 'ERROR: Speed out of valid range';
    ipStrategy    := 0;
    SelectStrategy := FALSE;
    RETURN;
END_IF

sLog           := CONCAT('Program selected: ', ipStrategy.GetProgramName());
SelectStrategy := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{2d973bb1-1019-4bf5-b0f1-6f99297b2521}">
      <Declaration><![CDATA[METHOD  Start : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Edge case — no strategy
IF ipStrategy = 0 THEN
    sLog  := 'ERROR: No program selected';
    Start  := FALSE;
    RETURN;
END_IF

// Edge case — already running
IF THIS^.IsRunning THEN
    sLog  := 'ERROR: Machine already running';
    Start  := FALSE;
    RETURN;
END_IF

// Edge case — door must be closed
IF NOT bDoorClosed THEN
    sLog  := 'ERROR: Please close the door first';
    Start  := FALSE;
    RETURN;
END_IF

// Edge case — clear previous error first
IF eCurrentState = E_WashState.ERROR THEN
    sLog  := 'ERROR: Please reset error before starting';
    Start  := FALSE;
    RETURN;
END_IF

// Call strategy start
ipStrategy.Start();

// Transition: IDLE ──► FILLING
eCurrentState  := E_WashState.FILLING;
fbOnStateTimer.IN := FALSE;
sLog           := CONCAT('Started program: ', ipStrategy.GetProgramName());
Start           := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{1c3be39f-7ad2-40d8-b663-0a6b75deae94}">
      <Declaration><![CDATA[METHOD  Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Edge case — already idle
IF eCurrentState = E_WashState.IDLE THEN
    sLog := 'Machine already stopped';
    Stop  := FALSE;
    RETURN;
END_IF

// Transition: ANY ──► IDLE
eCurrentState    := E_WashState.IDLE;
bWaterDetected   := FALSE;
tRemainingTime   := T#0S;
fbOnStateTimer.IN := FALSE;
sLog              := 'Machine stopped by user';
Stop              := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="TotalCycles" Id="{a536fdf1-da32-4085-a9e0-c4f140767b87}">
      <Declaration><![CDATA[PROPERTY  TotalCycles : INT]]></Declaration>
      <Get Name="Get" Id="{460fa856-c925-4219-9de4-169c1c9cd596}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TotalCycles := nTotalCycles;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{86958ca9-0a3e-4e37-bee5-a938f81356ef}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="TriggerError" Id="{e7f4b106-1b49-4074-a7ba-f2b7a6c8c30d}">
      <Declaration><![CDATA[METHOD TriggerError : BOOL
VAR_INPUT
	   sMsg : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Transition: ANY ──► ERROR
bError           := TRUE;
sErrorMsg        := sMsg;
eCurrentState    := E_WashState.ERROR;
bWaterDetected   := FALSE;
fbOnStateTimer.IN := FALSE;
sLog             := CONCAT('ERROR: ', sMsg);]]></ST>
      </Implementation>
    </Method>
