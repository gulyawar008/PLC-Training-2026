<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_WashingMachineController" Id="{7fc4a27f-0c32-4ced-8960-689687115f9f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_WashingMachineController
VAR
	// ── State ────────────────
	eState : E_WashState;
	bStateEntry : BOOL;
	 // ── Strategy (interface reference) ─────────────────────────
	ipStrategy : I_WashStrategy;
	bStrategySet : BOOL := FALSE;
	 // ── Active settings (loaded from strategy) ─────────────
    stWashSettings : ST_WashSettings;
	tRinseTime : TIME;
	tSpinTime : TIME;
	 // ── Control flags ──────────────────────────────────────────
	bDoorLocked : BOOL;
	bRunning : BOOL;
	tRemainingTime : TIME;
	  // ── Outputs / Log ───────────────────────────
	sLog : STRING;
	sErrorMessage: STRING;
	  // ── Timers ───────────────────
    fbOnState : TON;    // Drives each state duration
	fbOnDone : TON;   // Auto-return from DONE to IDLE
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ════════════════════════════════════════════════════════════
// TIMER — runs every scan, IN/PT set on state entry
// ════════════════════════════════════════════════════════════
fbOnState (IN :=  bRunning, PT := stWashSettings.tWashDuration);
fbOnDone (IN := (eState = E_WashState.DONE), PT := GVL_WashConstants.DONE_HOLD_TIME);

// ════════════════════════════════════════════════════════════

CASE eState OF
    E_WashState.WASHING  : tRemainingTime := stWashSettings.tWashDuration -  fbOnState.ET;
    E_WashState.RINSING  : tRemainingTime := tRinseTime -  fbOnState.ET;
    E_WashState.SPINNING : tRemainingTime := tSpinTime -  fbOnState.ET;
    E_WashState.DONE     : tRemainingTime := GVL_WashConstants.DONE_HOLD_TIME -  fbOnState.ET;
    ELSE                   tRemainingTime := T#0S;
END_CASE
// STATE MACHINE
// ════════════════════════════════════════════════════════════
CASE eState OF

    // ─────────────────────────────────────────────────────────
    E_WashState.IDLE:
        IF bStateEntry THEN
            bRunning    := FALSE;
            bDoorLocked := FALSE;
            sLog        := 'STATE: IDLE — Select program and press Start.';
            bStateEntry := FALSE;
        END_IF

    // ─────────────────────────────────────────────────────────
    E_WashState.WASHING:
        IF bStateEntry THEN
            fbOnState(IN := FALSE, PT := stWashSettings.tWashDuration);   // Reset
            fbOnState(IN := TRUE,  PT := stWashSettings.tWashDuration);   // Restart
            sLog        := CONCAT('STATE: WASHING — Program: ',
                             CONCAT(ipStrategy.GetProgramName(),
                             CONCAT(' | Temp: ',
                             CONCAT(REAL_TO_STRING(stWashSettings.rWashTemperature), 'C'))));
            bStateEntry := FALSE;
        END_IF

       fbOnState(IN := TRUE, PT := stWashSettings.tWashDuration);

        IF fbOnState.Q THEN
            sLog := 'TRANSITION: WASHING → RINSING';
            GoTo(E_WashState.RINSING);
        END_IF

    // ─────────────────────────────────────────────────────────
    E_WashState.RINSING:
        IF bStateEntry THEN
            fbOnState(IN := FALSE, PT := tRinseTime);
            fbOnState(IN := TRUE,  PT := tRinseTime);
            sLog        := 'STATE: RINSING — Rinse cycle active.';
            bStateEntry := FALSE;
        END_IF

        fbOnState(IN := TRUE, PT := tRinseTime);

        IF fbOnState.Q THEN
            sLog := 'TRANSITION: RINSING → SPINNING';
            GoTo(E_WashState.SPINNING);
        END_IF

    // ─────────────────────────────────────────────────────────
    E_WashState.SPINNING:
        IF bStateEntry THEN
            fbOnState(IN := FALSE, PT := tSpinTime);
            fbOnState(IN := TRUE,  PT := tSpinTime);
            sLog        := CONCAT('STATE: SPINNING — Speed: ',
                             CONCAT(UINT_TO_STRING(stWashSettings.nSpinSpeed), ' RPM'));
            bStateEntry := FALSE;
        END_IF

      fbOnState(IN := TRUE, PT := tSpinTime);

        IF fbOnState.Q THEN
            sLog := 'TRANSITION: SPINNING → DONE';
            GoTo(E_WashState.DONE);
        END_IF

    // ─────────────────────────────────────────────────────────
    E_WashState.DONE:
        IF bStateEntry THEN
            bRunning    := FALSE;
            sLog        := 'STATE: DONE — Cycle complete. Door unlocking soon.';
            bStateEntry := FALSE;
        END_IF

        fbOnDone (IN := TRUE, PT := GVL_WashConstants.DONE_HOLD_TIME);

        IF fbOnDone.Q THEN
            sLog := 'TRANSITION: DONE → IDLE — Ready for next cycle.';
            GoTo(E_WashState.IDLE);
        END_IF

    // ─────────────────────────────────────────────────────────
    E_WashState.ERROR:
        IF bStateEntry THEN
            bRunning    := FALSE;
            bDoorLocked := FALSE;
            sLog        := CONCAT('STATE: ERROR — ', sErrorMessage);
            bStateEntry := FALSE;
        END_IF
        // Cleared only via ResetError() method

    ELSE
        GoTo(E_WashState.IDLE);

END_CASE]]></ST>
    </Implementation>
    <Property Name="CurrentState" Id="{70a0c70f-3295-4c0b-85d7-ddae0e3e25cd}">
      <Declaration><![CDATA[PROPERTY CurrentState :   E_WashState]]></Declaration>
      <Get Name="Get" Id="{cf5253cd-4acc-4491-9e36-927a003fcc08}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ CurrentState := eState;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{8885170d-81eb-489e-9c57-6550d43e6654}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ErrorMessage" Id="{26ff4968-343c-4b0f-9051-1fccfe0500d9}">
      <Declaration><![CDATA[PROPERTY ErrorMessage : STRING]]></Declaration>
      <Get Name="Get" Id="{3fc77ff1-c683-473d-af4a-a250dd2c249b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorMessage := sErrorMessage;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f1f453e2-b0ab-4a47-9cfc-7f72a96a3eae}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="GoTo" Id="{d4598384-a709-41be-aa0f-2859959f77cf}">
      <Declaration><![CDATA[METHOD PRIVATE GoTo
VAR_INPUT
	eNext : E_WashState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eState      := eNext;
bStateEntry := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsRunning" Id="{a32e8a7b-4e05-436a-b646-a2d6aeca3d9d}">
      <Declaration><![CDATA[PROPERTY IsRunning : BOOL]]></Declaration>
      <Get Name="Get" Id="{4558f279-cc0e-4d5b-b7a1-53e2f92d340b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsRunning := bRunning;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{b9bb3ef9-f595-479f-af27-735c740358fd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="LockDoor" Id="{3eec9bb8-55df-4091-9aa7-622d463eec0d}">
      <Declaration><![CDATA[METHOD LockDoor : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF 	eState <> E_WashState.IDLE THEN
	 sLog    := 'ERROR: Door can only be locked from IDLE state.';
	 LockDoor := FALSE;
     RETURN;
END_IF
	

  bDoorLocked := TRUE;
 sLog        := 'Door LOCKED — Ready to start.';
 LockDoor := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="LogMessage" Id="{25136d02-14b5-4c9c-89c5-6cc11d5fee4a}">
      <Declaration><![CDATA[PROPERTY LogMessage : STRING]]></Declaration>
      <Get Name="Get" Id="{14da5d7a-fae8-4b46-bbad-becebcfc288e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LogMessage := sLog;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f2452bc6-06a6-4ebb-9514-24507317f267}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RemainingTime" Id="{f67247ae-1aa6-471b-9021-deb4ec55adb5}">
      <Declaration><![CDATA[PROPERTY RemainingTime : TIME]]></Declaration>
      <Get Name="Get" Id="{af15e642-a633-4b27-8935-77056598e6d4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RemainingTime := tRemainingTime;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{2439958a-9173-4fcb-94e3-7a4ea4a64ca5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="ResetError" Id="{9487abd7-fa45-4f62-adea-14916516e1db}">
      <Declaration><![CDATA[METHOD ResetError : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF 	eState <> E_WashState.ERROR THEN
	 sLog    := 'ERROR: Door can only be locked from IDLE state.';
	 ResetError := FALSE;
     RETURN;
END_IF


sErrorMessage := '';
bStrategySet := FALSE;
sLog := 'RESET: Error cleared. Select program and restart.';
GoTo(E_WashState.IDLE);
ResetError    := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectStrategy" Id="{49dc33aa-a66e-47eb-a6c6-a164cba62a70}">
      <Declaration><![CDATA[METHOD SelectStrategy : BOOL
VAR_INPUT
	ipGetStrategy : I_WashStrategy;
	
END_VAR
VAR
	rCheck : REAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bRunning THEN
	sLog := 'ERROR: Cannot change program while running.';
	SelectStrategy := FALSE;
	RETURN;
END_IF

IF ipGetStrategy = 0 THEN
	sLog := 'ERROR: Invalid strategy reference.';
	SelectStrategy := FALSE;
	RETURN;
END_IF


ipStrategy := ipGetStrategy;
stWashSettings := ipStrategy.GetWashSettings();
tRinseTime := ipStrategy.GetRinseTime();
tSpinTime := ipStrategy.GetSpinTime();
bStrategySet := TRUE;

rCheck := stWashSettings.rWashTemperature;

IF stWashSettings.rWashTemperature > GVL_WashConstants.TEMP_MAX OR
	stWashSettings.rWashTemperature < GVL_WashConstants.TEMP_MIN THEN
	sErrorMessage := 'Temperature out of safe range';
	GoTo(E_WashState.ERROR);
	SelectStrategy := FALSE;
	RETURN;
END_IF

IF stWashSettings.nSpinSpeed > GVL_WashConstants.SPIN_MAX OR
	stWashSettings.nSpinSpeed < GVL_WashConstants.SPIN_MIN THEN
	sErrorMessage := 'Spin speed out of safe range';
	GoTo(E_WashState.ERROR);
	SelectStrategy := FALSE;
	RETURN;
END_IF

    sLog       := CONCAT('Program selected: ', ipStrategy.GetProgramName());
    SelectStrategy := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{766b4417-1904-491d-98c8-fc20a0dc3402}">
      <Declaration><![CDATA[METHOD Start : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ // Guard: must be in IDLE
 IF eState <> E_WashState.IDLE THEN
	 sLog  := 'ERROR: Machine is not in IDLE state.';
	 Start := FALSE;
	 RETURN;
 END_IF
 
 
     // Guard: strategy must be selected
	 IF NOT bStrategySet OR ipStrategy =0 THEN
		sLog  := 'ERROR: No wash program selected.';
        Start  := FALSE;
        RETURN;
	 END_IF
	 
	     // Guard: door must be locked
	IF NOT bDoorLocked THEN
		 sLog  := 'ERROR: Door not locked. Call LockDoor() first.';
        Start  := FALSE;
        RETURN;
	END_IF
	
bRunning :=TRUE;
sLog     := CONCAT('START: Launching program — ', ipStrategy.GetProgramName());
GoTo(E_WashState.WASHING);
Start := TRUE;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{96768b97-327f-44a7-968b-f08403126452}">
      <Declaration><![CDATA[METHOD Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bRunning THEN
	 sLog := 'STOP: Machine was not running.';
	RETURN;
END_IF

sErrorMessage := 'Cycle stopped by operator';
sLog      := 'STOP: Operator stopped the machine.';
GoTo(E_WashState.ERROR);]]></ST>
      </Implementation>
    </Method>
