      <LineId Id="102" Count="0" />
      <LineId Id="95" Count="6" />
      <LineId Id="69" Count="1" />
      <LineId Id="46" Count="6" />
      <LineId Id="36" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>