    <Method Name="SetAlarm" Id="{cd065b06-f720-47e5-8a8d-1454ed7a154b}">
      <Declaration><![CDATA[METHOD SetAlarm : BOOL
VAR_INPUT
	sMsg : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bActive  := TRUE;
sMessage := sMsg;]]></ST>
      </Implementation>
    </Method>
