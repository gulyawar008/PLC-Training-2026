        </Implementation>
      </Get>
      <Set Name="Set" Id="{96408d8f-a00b-4ec3-bec1-62d875f9ed00}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Message" Id="{c9bddd77-eeab-4f31-afa6-1d4aaea1a8fa}">
      <Declaration><![CDATA[PROPERTY Message : STRING]]></Declaration>
      <Get Name="Get" Id="{ebdd30fd-6652-44b3-b835-7dfdb686c2ff}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Message := sMessage;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{82bbe2dd-f29f-437e-8f26-ad6e94d2dd29}">
        <Declaration><![CDATA[VAR
END_VAR
