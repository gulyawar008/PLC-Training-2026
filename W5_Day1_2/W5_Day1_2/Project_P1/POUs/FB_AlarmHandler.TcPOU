<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_AlarmHandler" Id="{048ed448-ae4b-4070-8f07-f8008abbe27d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AlarmHandler
VAR
	  bActive   : BOOL   := FALSE;
      sMessage  : STRING := '';
      tonBlink  : TON;
      bLampState: BOOL   := FALSE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Blink alarm lamp when active
tonBlink(IN := bActive, PT := GVL_Constants.ALARM_BLINK);

IF tonBlink.Q THEN
    bLampState        := NOT bLampState;
    tonBlink(IN := FALSE, PT := GVL_Constants.ALARM_BLINK);
    tonBlink(IN := TRUE,  PT := GVL_Constants.ALARM_BLINK);
END_IF

GVL_IO.bAlarmLamp  := bActive AND bLampState;
GVL_IO.sAlarmMsg   := sMessage;

]]></ST>
    </Implementation>
    <Method Name="ClearAlarm" Id="{f6aa93e6-7af7-4737-97d7-ba64ba17d6ca}">
      <Declaration><![CDATA[METHOD ClearAlarm : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ bActive   := FALSE;
 sMessage  := '';
 bLampState:= FALSE;
    GVL_IO.bAlarmLamp := FALSE;]]></ST>
      </Implementation>
    </Method>
