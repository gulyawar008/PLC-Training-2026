<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <GVL Name="GVL_Constants" Id="{b8bd0a90-533c-4b12-9ac9-bd41f87a617b}">
    <Declaration><![CDATA[{attribute 'qualified_only'}

VAR_GLOBAL CONSTANT
    FILL_TIMEOUT    : TIME := T#15S;   // safety timeout
    FILL_DONE_DELAY : TIME := T#1S;    // pause after fill
    RESUME_DELAY    : TIME := T#3S;    // belt travel time
    SETTLE_DELAY    : TIME := T#500MS; // AUTO bottle settle
    BOTTLE_ARRIVE   : TIME := T#3S;    // AUTO bottle arrive
    SIM_FILL_TIME   : TIME := T#4S;    // AUTO fill duration
    MAX_BOTTLES     : INT  := 9999;
    ALARM_BLINK     : TIME := T#500MS;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>