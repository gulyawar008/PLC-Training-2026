      <Declaration><![CDATA[PROPERTY ErrorMessage : STRING]]></Declaration>
      <Get Name="Get" Id="{8387c281-0323-48c5-a7c1-7900485f94af}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorMessage := sErrorMessage; ]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{2afaca2f-d3dc-4310-b7e2-31172879f092}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="GoTo" Id="{0d6ddf0b-eea5-4757-815f-acba3a290d2f}">
      <Declaration><![CDATA[METHOD PRIVATE GoTo 
VAR_INPUT 
eNext : E_WashState;
END_VAR 
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eState := eNext;
bStateEntry := TRUE; ]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsRunning" Id="{05ce31fd-bba2-439b-a2ae-6ff6e930fec9}">
      <Declaration><![CDATA[PROPERTY IsRunning : BOOL]]></Declaration>
      <Get Name="Get" Id="{6ec5ce81-8d8a-4cb2-a657-4f8c749c0e28}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsRunning := bRunning; ]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{30254e30-a4d2-4e57-9824-9ea3d28be941}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="LockDoor" Id="{e3177fec-6683-41aa-94f6-9d039fb67bd4}">
      <Declaration><![CDATA[METHOD LockDoor : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState <> E_WashState.IDLE THEN 
	sLog := 'ERROR: Door lock only from IDLE.'; LockDoor := FALSE; RETURN;
END_IF 

bDoorLocked := TRUE; 
sLog := 'Door LOCKED.'; 
LockDoor := TRUE; 
]]></ST>
      </Implementation>
    </Method>
    <Property Name="LogMessage" Id="{e9542b3e-00d9-4d10-8acc-dad4ea2fc7b9}">
      <Declaration><![CDATA[PROPERTY LogMessage : STRING]]></Declaration>
      <Get Name="Get" Id="{0cc44213-e29f-46d7-b2b0-0d2e31cf18d4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LogMessage := sLog;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{882225c5-3cba-457f-942a-e086df3ee95f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RemainingTime" Id="{3e393044-01f3-4c2b-b907-f51eed3a5a8e}">
      <Declaration><![CDATA[PROPERTY  RemainingTime : TIME]]></Declaration>
      <Get Name="Get" Id="{57aa9742-0208-4dd7-9579-c7f79b9e0560}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ IF fbOnState.PT > fbOnState.ET THEN 
     RemainingTime := fbOnState.PT - fbOnState.ET; 
 ELSE 
     RemainingTime := T#0S; 
 END_IF ]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{7de6a2ec-98fc-4124-952c-9819ccee5d24}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="ResetError" Id="{6eb0be3c-ae30-46d6-bc3f-446ce0a650d5}">
      <Declaration><![CDATA[METHOD ResetError : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState <> E_WashState.ERROR THEN 
       sLog := 'RESET: Not in ERROR.'; ResetError := FALSE; RETURN; 
END_IF 
	
sErrorMessage    := ''; 
bStrategySet := FALSE; 
sLog         := 'RESET: Error cleared. Select program and restart.'; 
GoTo(E_WashState.IDLE);
ResetError := TRUE; 

 ]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectStrategy" Id="{11f9c0a5-9ac0-443b-9068-0c6940a261ee}">
      <Declaration><![CDATA[METHOD  SelectStrategy : BOOL

VAR_INPUT 
    ipStrategy : I_WashStrategy; 
END_VAR ]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bRunning THEN 
       sLog := 'ERROR: Cannot change program while running.';
        SelectStrategy := FALSE; RETURN; 
    END_IF 

    IF ipStrategy = 0 THEN 
        sLog := 'ERROR: Invalid strategy reference.'; 
        SelectStrategy := FALSE; RETURN;
    END_IF 

    ipGetStrategy   := ipStrategy; 
    stWashSettings   := ipGetStrategy.GetSettings(); 
    bStrategySet := TRUE; 

    IF stWashSettings.rTemperature > GVL_WashConstants.TEMP_MAX OR 
       stWashSettings.rTemperature < GVL_WashConstants.TEMP_MIN THEN 
        sErrorMessage := 'Temperature out of safe range'; 
        GoTo(E_WashState.ERROR); SelectStrategy := FALSE; RETURN; 
    END_IF 

    IF stWashSettings.nSpinSpeed > GVL_WashConstants.SPIN_MAX OR 
      stWashSettings.nSpinSpeed < GVL_WashConstants.SPIN_MIN THEN 
        sErrorMessage := 'Spin speed out of safe range'; 
        GoTo(E_WashState.ERROR); SelectStrategy := FALSE; RETURN; 
    END_IF 

    ipGetStrategy.Start();   
    sLog          := CONCAT('Program selected: ', ipGetStrategy.GetProgramName()); 
    SelectStrategy := TRUE; 
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{2d973bb1-1019-4bf5-b0f1-6f99297b2521}">
      <Declaration><![CDATA[METHOD  Start : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState <> E_WashState.IDLE THEN 
        sLog := 'ERROR: Not in IDLE.'; Start := FALSE; RETURN; 
END_IF 
	
IF NOT bStrategySet OR ipGetStrategy = 0 THEN 
    sLog := 'ERROR: No program selected.'; Start := FALSE; RETURN; 
END_IF 
	
IF NOT bDoorLocked THEN 
        sLog := 'ERROR: Door not locked.'; Start := FALSE; RETURN; 
END_IF 

    bRunning := TRUE; 
    sLog     := CONCAT('START: ', ipGetStrategy.GetProgramName()); 
    GoTo(E_WashState.FILLING);   
    Start     := TRUE; 

 ]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{1c3be39f-7ad2-40d8-b663-0a6b75deae94}">
      <Declaration><![CDATA[METHOD  Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bRunning THEN 
      sLog := 'STOP: Not running.'; RETURN; 
END_IF 

sErrorMessage := 'Cycle stopped by operator'; 
GoTo(E_WashState.ERROR); 
]]></ST>
      </Implementation>
    </Method>
    <Property Name="WashDuration" Id="{94ebbba6-10d1-4fb1-b3fe-8a14774ccaa3}">
      <Declaration><![CDATA[PROPERTY WashDuration : TIME]]></Declaration>
      <Get Name="Get" Id="{3ff4800e-bf6c-4d5e-ae3e-6baa3b76ca66}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF bStrategySet AND ipGetStrategy <> 0 THEN
   WashDuration := ipGetStrategy.GetDuration();
ELSE
   WashDuration := T#0S;
END_IF]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{66c8d3f3-e5b6-466a-b023-197b4efad9aa}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
