<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_WashingMachine" Id="{182d94af-703d-4404-b9f5-16db70894ffa}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_WashingMachine
VAR
    eState      : E_WashState := E_WashState.IDLE; 
    bStateEntry : BOOL        := TRUE; 

    ipGetStrategy   : I_WashStrategy; 
    bStrategySet : BOOL := FALSE; 

    stWashSettings  : ST_WashSettings; 

   bDoorLocked : BOOL := FALSE; 
   bRunning    : BOOL := FALSE; 

    sLog      : STRING; 
    sErrorMessage : STRING; 

    fbOnState     : TON;    
    fbOnCompleted : TON;   

	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbOnState    (IN := bRunning, PT := stWashSettings.tWashDuration); 
fbOnCompleted(IN := (eState = E_WashState.COMPLETED),  PT := GVL_WashConstants.COMPLETED_HOLD_TIME); 


CASE eState OF 
  E_WashState.IDLE: 
    IF bStateEntry THEN 
        bRunning    := FALSE; 
        bDoorLocked := FALSE; 
        sLog        := 'STATE: IDLE — Select program and press Start.'; 
        bStateEntry := FALSE; 
    END_IF 

  E_WashState.FILLING:                     
    IF bStateEntry THEN 
        fbOnState(IN := FALSE, PT := GVL_WashConstants.FILL_TIME); 
        fbOnState(IN := TRUE,  PT := GVL_WashConstants.FILL_TIME); 
        sLog        := 'STATE: FILLING — Drum filling with water.'; 
        bStateEntry := FALSE; 
    END_IF 

    fbOnState(IN := TRUE, PT := GVL_WashConstants.FILL_TIME); 
    IF fbOnState.Q THEN 
        sLog := 'TRANSITION: FILLING → WASHING'; 
        GoTo(E_WashState.WASHING); 
    END_IF 

  E_WashState.WASHING: 
    IF bStateEntry THEN 
        fbOnState(IN := FALSE, PT := stWashSettings.tWashDuration); 
        fbOnState(IN := TRUE,  PT := stWashSettings.tWashDuration); 
        sLog := CONCAT('STATE: WASHING — Program: ', 
                  CONCAT(ipGetStrategy.GetProgramName(), 
                  CONCAT(' | Temp: ', 
                  CONCAT(REAL_TO_STRING(stWashSettings.rTemperature), 'C')))); 
        bStateEntry := FALSE; 
    END_IF 

    fbOnState(IN := TRUE, PT := stWashSettings.tWashDuration); 
    IF fbOnState.Q THEN 
        sLog := 'TRANSITION: WASHING → DRAINING'; 
        GoTo(E_WashState.DRAINING); 
    END_IF 

  E_WashState.DRAINING:                    
    IF bStateEntry THEN 
        fbOnState(IN := FALSE, PT := GVL_WashConstants.DRAIN_TIME); 
        fbOnState(IN := TRUE,  PT := GVL_WashConstants.DRAIN_TIME); 
        sLog        := 'STATE: DRAINING — Emptying drum.'; 
        bStateEntry := FALSE; 
    END_IF 

    fbOnState(IN := TRUE, PT := GVL_WashConstants.DRAIN_TIME); 
    IF fbOnState.Q THEN 
        sLog := 'TRANSITION: DRAINING → COMPLETED'; 
        GoTo(E_WashState.COMPLETED); 
    END_IF 

  E_WashState.COMPLETED: 
    IF bStateEntry THEN 
        bRunning    := FALSE; 
        sLog        := 'STATE: COMPLETED — Cycle done. Door unlocking soon.'; 
        bStateEntry := FALSE; 
    END_IF 

    fbOnCompleted(IN := TRUE, PT := GVL_WashConstants.COMPLETED_HOLD_TIME); 

    IF fbOnCompleted.Q THEN 
        sLog := 'TRANSITION: COMPLETED → IDLE'; 
        GoTo(E_WashState.IDLE); 
    END_IF 

  E_WashState.ERROR: 
    IF bStateEntry THEN 
        bRunning    := FALSE; 
        bDoorLocked := FALSE; 
        sLog        := CONCAT('STATE: ERROR — ', sErrorMessage); 
        bStateEntry := FALSE; 
    END_IF  
  ELSE 

    GoTo(E_WashState.IDLE); 
END_CASE ]]></ST>
    </Implementation>
    <Property Name="CurrentState" Id="{d69cb94e-a7b2-4bd0-9661-5e10d0a1df2b}">
      <Declaration><![CDATA[PROPERTY CurrentState : E_WashState]]></Declaration>
      <Get Name="Get" Id="{3fc6311a-f53f-4bce-a7c2-3e8078fa9d41}">
        <Declaration><![CDATA[VAR
	eCurrentState: E_WashState;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentState := eState; 

]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{097f0d05-d0e7-4c3a-aad4-5670303745e2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
